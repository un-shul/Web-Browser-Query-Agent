# Copy to .env and fill in. Every value is optional: with none of them set,
# the app runs the fully local stack (MiniLM + distilbart + on-disk ChromaDB).
#
# None of these services require a credit card.

# --- Backend selection ------------------------------------------------------
# LLM_PROVIDER:    gemini | groq | chain | fake | none
# EMBED_PROVIDER:  gemini | local
# VECTOR_STORE:    upstash | chroma
# SUMMARIZER:      llm | local
LLM_PROVIDER=none
EMBED_PROVIDER=local
VECTOR_STORE=chroma
SUMMARIZER=local

# Master kill switch: forces the deterministic no-LLM path everywhere.
LLM_DISABLED=0

# --- Web search (required -- DuckDuckGo/Google scraping is blocked) ---------
# https://tavily.com -- 1,000 searches/month free, no card
TAVILY_API_KEY=

# --- LLM inference ----------------------------------------------------------
# https://aistudio.google.com/apikey -- ~1,500 requests/day free, no card.
# Note: Google may use free-tier prompts to improve their models.
GEMINI_API_KEY=
# Defaults to gemini-flash-lite-latest. Override if you want a bigger model.
# GEMINI_MODEL=gemini-3.8-flash

# https://console.groq.com/keys -- ~14,400 requests/day free, no card.
# Used as the automatic fallback when Gemini returns 429.
GROQ_API_KEY=
# Defaults to openai/gpt-oss-20b.
# GROQ_MODEL=qwen/qwen3.8-27b

# --- Hosted vector store (only needed for deployment) -----------------------
# https://console.upstash.com -- 1GB free, no card.
#
# Create the index with 768 dimensions and COSINE distance. Both must match:
# the dimension is fixed at creation and has to equal GEMINI_EMBED_DIM, and
# every similarity threshold in the project assumes cosine. `python
# preflight.py --prod` checks both against the live index.
#
# Quoting the values is fine -- dotenv strips surrounding quotes.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# --- Local-only options -----------------------------------------------------
# Headless-browser fallback for JS-heavy pages. Requires requirements-dev.txt
# plus `python -m playwright install chromium`. Cannot run on Vercel.
ENABLE_PLAYWRIGHT=0

FLASK_DEBUG=0
